{
  "name": "@snowplow/react-native-tracker",
  "version": "1.0.2",
  "type": "module",
  "description": "A library for tracking Snowplow events in React Native",
  "homepage": "https://docs.snowplowanalytics.com/docs/collecting-data/collecting-from-own-applications/react-native-tracker/",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "compile": "rimraf dist && tsc -p .",
    "bundle": "rollup --config",
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "build": "npm run compile && npm run bundle && npm run build:plugin && rimraf dist/tmp",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "bootstrap": "npm run build && cd DemoApp && rimraf node_modules && yarn"
  },
  "files": [
    "dist",
    "android",
    "ios",
    "RNSnowplowTracker.podspec",
    "app.plugin.js",
    "plugin/build"
  ],
  "keywords": [
    "react-native",
    "snowplow"
  ],
  "author": "Snowplow Analytics Ltd",
  "contributors": [
    "Michael Hadam",
    "Colm O Griobhtha",
    "James Munro",
    "Max Bondarenko",
    "Paul Boocock",
    "Ada Tzereme"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/snowplow-incubator/snowplow-react-native-tracker"
  },
  "peerDependencies": {
    "expo": ">=52.0.0",
    "react": ">=16.8.6",
    "react-native": ">=0.59.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "expo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "^54.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.9",
    "@types/react": "^18.3.18",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^28.10.0",
    "eslint-plugin-promise": "^7.2.1",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.30.1",
    "rollup-plugin-dts": "^6.1.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*test.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/DemoApp/",
      "<rootDir>/DemoExpoApp/"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tests/tsconfig.json"
        }
      ]
    },
    "roots": [
      "<rootDir>/src/",
      "<rootDir>/tests/"
    ]
  }
}
